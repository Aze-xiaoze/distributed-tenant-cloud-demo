# 默认忽略的文件
/shelf/
/workspace.xml
# 基于编辑器的 HTTP 客户端请求
/httpRequests/
# Datasource local storage ignored files
/dataSources/
/dataSources.local.xml

# ========== 1. 核心：屏蔽所有层级的target编译目录 ==========
# 万能匹配，多模块项目所有子模块的target都会被忽略
**/target/
target/

# ========== 2. IDEA相关文件 ==========
.idea/
*.iml
*.iws
*.ipr
.idea/**/*

# ========== 3. Java编译产物 ==========
*.class
*.jar
*.war
*.ear
*.log

# ========== 4. 其他临时文件 ==========
*.tmp
*.bak
*.swp
.DS_Store
Thumbs.db